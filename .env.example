# Origen de datos: `mock` (datos de ejemplo en memoria) o `supabase` (datos reales).
VITE_DATA_MODE=mock

# Modo demo: muestra el selector "Ver como". Solo para el despliegue de demostración (con VITE_DATA_MODE=mock).
VITE_DEMO_MODE=false

# Solo con VITE_DATA_MODE=supabase. Usa ÚNICAMENTE la anon key; la service_role jamás va aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
