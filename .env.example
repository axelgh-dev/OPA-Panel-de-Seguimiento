# Origen de datos: `mock` (datos de ejemplo en memoria) o `supabase` (datos reales).
VITE_DATA_MODE=mock

# Modo demo: muestra el selector "Ver como". Solo aplica con VITE_DATA_MODE=mock
# (despliegue de demostración y desarrollo sin base de datos).
VITE_DEMO_MODE=true

# Solo con VITE_DATA_MODE=supabase. Usa ÚNICAMENTE la anon key; la service_role jamás va aquí.
# Local (Docker): `npm run db:start` imprime la URL y la anon key; guárdalas en .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
