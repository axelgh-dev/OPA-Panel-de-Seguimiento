{
  "name": "opa-panel-de-seguimiento",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portal de seguimiento de proyectos para OP&A (OPA Asesores)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,studio,edge-runtime,logflare,vector,supavisor,postgrest,postgres-meta",
    "db:reset": "supabase db reset",
    "db:test": "docker exec -i supabase_db_opa-panel psql -U postgres -d postgres -v ON_ERROR_STOP=1 -q -f - < supabase/tests/rls.sql 2>&1 | grep -E \"NOTICE|ERROR|CONTEXT\" | sed \"s/NOTICE:  //\""
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.108.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^2.6.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.3.0",
    "tailwindcss": "3.4",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
